{
  "name": "vue3-template",
  "version": "0.0.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host",
    "lint": "npm run lint:js && npm run lint:style",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:style -- --fix",
    "lint:js": "eslint --ext .js,.vue --ignore-path .gitignore src",
    "lint:style": "stylelint \"src/**/*.{vue,css}\" --ignore-path .gitignore",
    "serve": "vite preview",
    "copyfiles": "copyfiles -u 2 node_modules/leaflet/dist/images/* public/images",
    "dev:api": "node server.js"
  },
  "dependencies": {
    "body-parser": "^1.20.9",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue3-google-map": "^0.27.2",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "autoprefixer": "^10.6.1",
    "copyfiles": "^2.4.1",
    "eslint": "^10.13.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "eslint-plugin-vue": "^9.33.0",
    "leaflet": "^1.9.4",
    "postcss": "^8.5.31",
    "postcss-html": "^1.8.1",
    "stylelint": "^16.26.1",
    "stylelint-order": "^7.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-stylelint": "^6.3.0",
    "vite-svg-loader": "^5.1.3"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "stylelint-config-recommended-vue": {
      "stylelint-config-html": "^1.1.0",
      "stylelint-config-recommended": "^16.0.0"
    }
  }
}
